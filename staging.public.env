# Non-secret Staging settings. Cryptographic values are read only into the
# short-lived process running Docker Compose; they never belong in this file.
POSTGRES_DB=klasse5e_staging
POSTGRES_USER=klasse5e_staging
DJANGO_ALLOWED_HOSTS=staging.klassid.de,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://staging.klassid.de
APP_BASE_URL=https://staging.klassid.de
DEFAULT_FROM_EMAIL=KlassID Staging <noreply@klassid.de>
VAPID_SUBJECT=mailto:kontakt@klassid.de

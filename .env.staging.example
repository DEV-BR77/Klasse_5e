# Copy this file locally to .env.staging. It is intentionally ignored by Git.
# Use a dedicated HTTPS host, sender and generated secrets. Never copy a
# production database URL, media volume, key or personal data to staging.

POSTGRES_DB=klasse5e_staging
POSTGRES_USER=klasse5e_staging
POSTGRES_PASSWORD=replace-with-a-dedicated-staging-password
DJANGO_SECRET_KEY=replace-with-a-dedicated-staging-django-secret
VISION_SERVICE_TOKEN=replace-with-a-dedicated-staging-vision-token
WEBUNTIS_CREDENTIAL_ENCRYPTION_KEY=replace-with-a-dedicated-staging-fernet-key
ITSLEARNING_CREDENTIAL_ENCRYPTION_KEY=replace-with-a-dedicated-staging-fernet-key
MOBILITY_DATA_ENCRYPTION_KEY=replace-with-a-dedicated-staging-fernet-key
VAPID_PUBLIC_KEY=replace-with-a-dedicated-staging-vapid-public-key
VAPID_PRIVATE_KEY=replace-with-a-dedicated-staging-vapid-private-key
RESEND_API_KEY=replace-with-a-dedicated-staging-sending-key
MONITORING_INGEST_TOKEN=replace-with-a-dedicated-staging-monitoring-token

# Replace staging.klassid.example before use. Do not use klassid.de here.
DJANGO_ALLOWED_HOSTS=staging.klassid.example
DJANGO_CSRF_TRUSTED_ORIGINS=https://staging.klassid.example
APP_BASE_URL=https://staging.klassid.example
DEFAULT_FROM_EMAIL=KlassID Staging <noreply@staging.klassid.example>
VAPID_SUBJECT=mailto:kontakt@staging.klassid.example
